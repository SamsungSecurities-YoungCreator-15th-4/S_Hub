# frontend 환경변수 템플릿 (커밋 대상)
# 실제 값은 frontend/.env.local 에 넣고 절대 커밋하지 않는다. 이 파일은 플레이스홀더만 유지한다.
# Next.js는 브라우저 노출 변수에 NEXT_PUBLIC_ 접두사 필수.
# anon 키는 공개 전제 키라 NEXT_PUBLIC_ OK. service_role은 절대 프론트에 두지 마.

# --- Supabase (프론트: anon 키만) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- 백엔드 API 주소 ---
# Vercel Production은 Render 백엔드 주소를 단일 값으로 설정한다.
# 로컬 개발 시에는 frontend/.env.local 에서 http://localhost:8000 로 바꿔 쓴다.
# 쉼표로 여러 주소를 넣으면 fetch base URL이 깨진다.
NEXT_PUBLIC_API_BASE_URL=https://vvip-pb-advisor.onrender.com

# --- S.ymphony 리스크 리포트 ---
# S.upervisor 헤더의 "리스크 리포트" 버튼이 새 탭으로 여는 공개 URL.
NEXT_PUBLIC_SYMPHONY_URL=https://s-ymphony.streamlit.app/

# --- 시연 모드 ---
# "1" 이면 프론트가 백엔드(FastAPI·Supabase)를 호출하지 않고 고정 데이터를 쓴다.
# 로그인(AuthGuard)도 통과시키고, 화면 하단에 "시연 고정 데이터" 배너가 뜬다.
# 9/11 발표용 Vercel 배포에서만 1 로 두고, 개발·운영에서는 비워 둔다.
# "1" 이 아닌 값(0·false·빈 문자열)은 모두 꺼짐이다.
NEXT_PUBLIC_DEMO=
